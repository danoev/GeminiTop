 netadr_t master_adr;		// address of the master server
 
+#define QW_BROWSER_MAX_SERVERS 1024
+#define QW_BROWSER_QUERY_BURST 12
+#define QW_BROWSER_MAX_INFLIGHT 32
+#define QW_BROWSER_MASTER_TIMEOUT 1.0
+#define QW_BROWSER_SERVER_TIMEOUT 1.0
+#define QW_BROWSER_MASTER_RETRIES 3
+#define QW_BROWSER_SERVER_RETRIES 2
+
+typedef struct {
+    netadr_t adr;
+    qboolean active;
+    qboolean pending;
+    qboolean responded;
+    int attempts;
+    double sent_time;
+} qw_browser_master_t;
+
+typedef struct {
+    netadr_t adr;
+    qw_server_browser_entry_t info;
+    qboolean queried;
+    qboolean responded;
+    int attempts;
+    double sent_time;
+} qw_browser_server_t;
+
+static const char *const qw_browser_master_hosts[] = {
+    "5.9.97.180:27000",
+    "78.47.113.68:27000",
+    "master.quakeservers.net:27000",
+    "master.quakeworld.nu:27000",
+};
+
+static const byte qw_browser_master_request[] = { 'c', '\n' };
+static const byte qw_browser_status_request[] = {
+    255, 255, 255, 255, 's', 't', 'a', 't', 'u', 's', ' ', '8', '7', '\n'
+};
+
+static qw_browser_master_t qw_browser_masters[ARRAY_SIZE(qw_browser_master_hosts)];
+static qw_browser_server_t qw_browser_servers[QW_BROWSER_MAX_SERVERS];
+static int qw_browser_order[QW_BROWSER_MAX_SERVERS];
+static int qw_browser_server_count;
+static int qw_browser_visible_count;
+static int qw_browser_next_query;
+static int qw_browser_inflight;
+static qboolean qw_browser_refreshing;
+static qboolean qw_browser_sort_dirty;
+static char qw_browser_status[96];
+
+static void
+CL_ServerBrowser_SendMasterQuery(qw_browser_master_t *master)
+{
+    if (!master || !master->active)
+        return;
+
+    master->pending = true;
+    master->sent_time = realtime;
+    master->attempts++;
+    NET_SendPacket(sizeof(qw_browser_master_request),
+                   (void *)qw_browser_master_request, master->adr);
+}
+
+static void
+CL_ServerBrowser_SendStatusQuery(qw_browser_server_t *server)
+{
+    if (!server || server->responded)
+        return;
+
+    server->queried = true;
+    server->sent_time = realtime;
+    server->attempts++;
+    NET_SendPacket(sizeof(qw_browser_status_request),
+                   (void *)qw_browser_status_request, server->adr);
+}
+
+static void
+CL_ServerBrowser_UpdateStatus(void)
+{
+    int active_masters = 0;
+    int responded_masters = 0;
+
+    for (int i = 0; i < ARRAY_SIZE(qw_browser_masters); i++) {
+        if (!qw_browser_masters[i].active)
+            continue;
+        active_masters++;
+        if (qw_browser_masters[i].responded)
+            responded_masters++;
+    }
+
+    if (qw_browser_refreshing) {
+        qsnprintf(qw_browser_status, sizeof(qw_browser_status),
+                  "Masters %d/%d  Servers %d/%d  Pending %d",
+                  responded_masters, active_masters,
+                  qw_browser_visible_count, qw_browser_server_count,
+                  qw_browser_inflight);
+        return;
+    }
+
+    if (qw_browser_visible_count > 0) {
+        qsnprintf(qw_browser_status, sizeof(qw_browser_status),
+                  "%d server%s ready",
+                  qw_browser_visible_count,
+                  (qw_browser_visible_count == 1) ? "" : "s");
+    } else if (qw_browser_server_count > 0) {
+        qsnprintf(qw_browser_status, sizeof(qw_browser_status),
+                  "No reachable servers (%d address%s checked)",
+                  qw_browser_server_count,
+                  (qw_browser_server_count == 1) ? "" : "es");
+    } else if (active_masters > 0) {
+        qsnprintf(qw_browser_status, sizeof(qw_browser_status),
+                  "No master servers responded");
+    } else {
+        qsnprintf(qw_browser_status, sizeof(qw_browser_status),
+                  "Server browser idle");
+    }
+}
+
+static int
+CL_ServerBrowser_Compare(const void *lhs, const void *rhs)
+{
+    const qw_browser_server_t *a = &qw_browser_servers[*(const int *)lhs];
+    const qw_browser_server_t *b = &qw_browser_servers[*(const int *)rhs];
+    int cmp;
+
+    if (a->info.users != b->info.users)
+        return b->info.users - a->info.users;
+    if (a->info.ping != b->info.ping)
+        return a->info.ping - b->info.ping;
+
+    cmp = strcmp(a->info.name, b->info.name);
+    if (cmp)
+        return cmp;
+
+    return strcmp(a->info.address, b->info.address);
+}
+
+static void
+CL_ServerBrowser_RebuildOrder(void)
+{
+    int count = 0;
+
+    if (!qw_browser_sort_dirty)
+        return;
+
+    for (int i = 0; i < qw_browser_server_count; i++) {
+        if (qw_browser_servers[i].responded)
+            qw_browser_order[count++] = i;
+    }
+
+    qsort(qw_browser_order, count, sizeof(qw_browser_order[0]),
+          CL_ServerBrowser_Compare);
+    qw_browser_visible_count = count;
+    qw_browser_sort_dirty = false;
+}
+
+static int
+CL_ServerBrowser_FindServer(netadr_t adr)
+{
+    for (int i = 0; i < qw_browser_server_count; i++) {
+        if (NET_CompareAdr(qw_browser_servers[i].adr, adr))
+            return i;
+    }
+
+    return -1;
+}
+
+static void
+CL_ServerBrowser_Reset(void)
+{
+    memset(qw_browser_masters, 0, sizeof(qw_browser_masters));
+    memset(qw_browser_servers, 0, sizeof(qw_browser_servers));
+    memset(qw_browser_order, 0, sizeof(qw_browser_order));
+    qw_browser_server_count = 0;
+    qw_browser_visible_count = 0;
+    qw_browser_next_query = 0;
+    qw_browser_inflight = 0;
+    qw_browser_refreshing = false;
+    qw_browser_sort_dirty = true;
+    qw_browser_status[0] = '\0';
+}
+
+static void
+CL_ServerBrowser_AddServer(const netadr_t *adr)
+{
+    qw_browser_server_t *server;
+
+    if (!adr || !adr->port)
+        return;
+    if (CL_ServerBrowser_FindServer(*adr) >= 0)
+        return;
+    if (qw_browser_server_count >= QW_BROWSER_MAX_SERVERS)
+        return;
+
+    server = &qw_browser_servers[qw_browser_server_count++];
+    memset(server, 0, sizeof(*server));
+    server->adr = *adr;
+    qsnprintf(server->info.address, sizeof(server->info.address), "%s",
+              NET_AdrToString(*adr));
+    qsnprintf(server->info.name, sizeof(server->info.name), "%s",
+              server->info.address);
+    qsnprintf(server->info.map, sizeof(server->info.map), "-");
+}
+
+static void
+CL_ServerBrowser_ParsePlayers(qw_browser_server_t *server, char *players)
+{
+    int users = 0;
+
+    while (players && *players) {
+        while (*players == '\n' || *players == '\r')
+            players++;
+        if (!*players)
+            break;
+        users++;
+        while (*players && *players != '\n' && *players != '\r')
+            players++;
+    }
+
+    server->info.users = users;
+}
+
+static qboolean
+CL_ServerBrowser_HandleMasterReply(void)
+{
+    int master_index = -1;
+
+    if (!qw_browser_refreshing || net_message.cursize < 6 || net_message.data[5] != '\n')
+        return false;
+
+    for (int i = 0; i < ARRAY_SIZE(qw_browser_masters); i++) {
+        if (qw_browser_masters[i].active &&
+            NET_CompareAdr(qw_browser_masters[i].adr, net_from)) {
+            master_index = i;
+            break;
+        }
+    }
+
+    if (master_index < 0)
+        return false;
+
+    qw_browser_masters[master_index].pending = false;
+    qw_browser_masters[master_index].responded = true;
+
+    for (int offset = 6; offset + 5 < net_message.cursize; offset += 6) {
+        netadr_t adr;
+
+        memset(&adr, 0, sizeof(adr));
+        memcpy(adr.ip.b, net_message.data + offset, sizeof(adr.ip.b));
+        memcpy(&adr.port, net_message.data + offset + 4, sizeof(adr.port));
+        CL_ServerBrowser_AddServer(&adr);
+    }
+
+    CL_ServerBrowser_UpdateStatus();
+    return true;
+}
+
+static qboolean
+CL_ServerBrowser_HandleStatusReply(void)
+{
+    char response[2048];
+    char *players;
+    qw_browser_server_t *server;
+    int index;
+    size_t copy_len;
+
+    index = CL_ServerBrowser_FindServer(net_from);
+    if (index < 0 || !qw_browser_servers[index].queried || net_message.cursize < 6)
+        return false;
+
+    server = &qw_browser_servers[index];
+    if (!server->responded && qw_browser_inflight > 0)
+        qw_browser_inflight--;
+    if (!server->responded)
+        qw_browser_visible_count++;
+
+    server->queried = false;
+    server->responded = true;
+    server->info.ping = qmin((int)((realtime - server->sent_time) * 1000.0 + 0.5), 9999);
+
+    copy_len = (size_t)net_message.cursize - 5;
+    if (copy_len >= sizeof(response))
+        copy_len = sizeof(response) - 1;
+    memcpy(response, net_message.data + 5, copy_len);
+    response[copy_len] = '\0';
+
+    while (copy_len > 0 &&
+           (response[copy_len - 1] == '\0' ||
+            response[copy_len - 1] == '\n' ||
+            response[copy_len - 1] == '\r')) {
+        response[--copy_len] = '\0';
+    }
+
+    players = strchr(response, '\n');
+    if (players)
+        *players++ = '\0';
+
+    qstrncpy(server->info.name, Info_ValueForKey(response, "hostname"),
+             sizeof(server->info.name));
+    if (!server->info.name[0])
+        qstrncpy(server->info.name, server->info.address, sizeof(server->info.name));
+
+    qstrncpy(server->info.map, Info_ValueForKey(response, "map"),
+             sizeof(server->info.map));
+    if (!server->info.map[0])
+        qstrncpy(server->info.map, "-", sizeof(server->info.map));
+
+    server->info.maxusers = Q_atoi(Info_ValueForKey(response, "maxclients"));
+    CL_ServerBrowser_ParsePlayers(server, players);
+    qw_browser_sort_dirty = true;
+    CL_ServerBrowser_UpdateStatus();
+    return true;
+}
+
+static void
+CL_ServerBrowser_Frame(void)
+{
+    int send_budget = QW_BROWSER_QUERY_BURST;
+    qboolean masters_pending = false;
+
+    if (!qw_browser_refreshing)
+        return;
+
+    for (int i = 0; i < ARRAY_SIZE(qw_browser_masters); i++) {
+        if (!qw_browser_masters[i].active || !qw_browser_masters[i].pending)
+            continue;
+        if (realtime - qw_browser_masters[i].sent_time > QW_BROWSER_MASTER_TIMEOUT) {
+            if (qw_browser_masters[i].attempts < QW_BROWSER_MASTER_RETRIES) {
+                CL_ServerBrowser_SendMasterQuery(&qw_browser_masters[i]);
+                masters_pending = true;
+            } else {
+                qw_browser_masters[i].pending = false;
+            }
+        } else {
+            masters_pending = true;
+        }
+    }
+
+    for (int i = 0; i < qw_browser_server_count; i++) {
+        if (!qw_browser_servers[i].queried || qw_browser_servers[i].responded)
+            continue;
+        if (realtime - qw_browser_servers[i].sent_time > QW_BROWSER_SERVER_TIMEOUT) {
+            if (qw_browser_servers[i].attempts < QW_BROWSER_SERVER_RETRIES) {
+                CL_ServerBrowser_SendStatusQuery(&qw_browser_servers[i]);
+            } else {
+                qw_browser_servers[i].queried = false;
+                if (qw_browser_inflight > 0)
+                    qw_browser_inflight--;
+            }
+        }
+    }
+
+    while (send_budget > 0 &&
+           qw_browser_inflight < QW_BROWSER_MAX_INFLIGHT &&
+           qw_browser_next_query < qw_browser_server_count) {
+        qw_browser_server_t *server = &qw_browser_servers[qw_browser_next_query++];
+
+        if (server->queried || server->responded)
+            continue;
+
+        qw_browser_inflight++;
+        CL_ServerBrowser_SendStatusQuery(server);
+        send_budget--;
+    }
+
+    if (!masters_pending &&
+        qw_browser_next_query >= qw_browser_server_count &&
+        qw_browser_inflight == 0) {
+        qw_browser_refreshing = false;
+    }
+
+    CL_ServerBrowser_UpdateStatus();
+}
+
+void
+CL_ServerBrowser_Refresh(void)
+{
+    CL_ServerBrowser_Reset();
+
+    for (int i = 0; i < ARRAY_SIZE(qw_browser_master_hosts); i++) {
+        if (!NET_StringToAdr(qw_browser_master_hosts[i], &qw_browser_masters[i].adr))
+            continue;
+
+        qw_browser_masters[i].active = true;
+        CL_ServerBrowser_SendMasterQuery(&qw_browser_masters[i]);
+    }
+
+    qw_browser_refreshing = true;
+    CL_ServerBrowser_UpdateStatus();
+}
+
+void
+CL_ServerBrowser_Cancel(void)
+{
+    for (int i = 0; i < ARRAY_SIZE(qw_browser_masters); i++)
+        qw_browser_masters[i].pending = false;
+    for (int i = 0; i < qw_browser_server_count; i++)
+        qw_browser_servers[i].queried = false;
+
+    qw_browser_inflight = 0;
+    qw_browser_refreshing = false;
+    CL_ServerBrowser_UpdateStatus();
+}
+
+qboolean
+CL_ServerBrowser_IsRefreshing(void)
+{
+    return qw_browser_refreshing;
+}
+
+int
+CL_ServerBrowser_Count(void)
+{
+    CL_ServerBrowser_RebuildOrder();
+    return qw_browser_visible_count;
+}
+
+const qw_server_browser_entry_t *
+CL_ServerBrowser_Get(int index)
+{
+    CL_ServerBrowser_RebuildOrder();
+    if (index < 0 || index >= qw_browser_visible_count)
+        return NULL;
+    return &qw_browser_servers[qw_browser_order[index]].info;
+}
+
+const char *
+CL_ServerBrowser_Status(void)
+{
+    if (!qw_browser_status[0])
+        CL_ServerBrowser_UpdateStatus();
+    return qw_browser_status;
+}
