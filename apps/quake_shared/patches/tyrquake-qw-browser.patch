+{
+    switch (keynum) {
+    case K_ESCAPE:
+        M_Menu_Main_f();
+        break;
+
+    case K_UPARROW:
+    case K_DOWNARROW:
+        S_LocalSound("misc/menu1.wav");
+        qw_join_cursor ^= 1;
+        break;
+
+    case K_ENTER:
+        m_entersound = true;
+        if (qw_join_cursor == QW_JOIN_CURSOR_REFRESH) {
+            M_Menu_Search_f();
+            break;
+        }
+
+        if (qw_joinname[0]) {
+            key_dest = key_game;
+            m_state = m_none;
+            Cbuf_AddText("connect \"%s\"\n", qw_joinname);
+        }
+        break;
+
+    case K_BACKSPACE:
+        if (qw_join_cursor == QW_JOIN_CURSOR_ADDRESS && qw_joinname[0])
+            qw_joinname[strlen(qw_joinname) - 1] = '\0';
+        break;
+
+    default: {
+        size_t length;
+
+        if (qw_join_cursor != QW_JOIN_CURSOR_ADDRESS)
+            break;
+        if (keynum < K_SPACE || keynum > K_DEL)
+            break;
+        length = strlen(qw_joinname);
+        if (length + 1 >= sizeof(qw_joinname))
+            break;
+        qw_joinname[length] = keynum;
+        qw_joinname[length + 1] = '\0';
+        break;
+    }
+    }
+}
+
+static void
+M_Menu_Search_f(void)
+{
+    key_dest = key_menu;
+    m_state = m_search;
+    m_entersound = false;
+    qw_search_complete_time = 0;
+    CL_ServerBrowser_Refresh();
+}
+
+static void
+M_Search_Draw(void)
+{
+    const qpic8_t *p;
+    int x;
+
+    p = Draw_CachePic("gfx/p_multi.lmp");
+    M_DrawTransPic((320 - p->width) / 2, 4, p);
+    x = (320 / 2) - ((26 * 8) / 2) + 4;
+    M_DrawTextBox(x - 8, 32, 26, 3);
+    M_Print(x, 40, "Refreshing QuakeWorld list");
+    M_Print(x, 56, CL_ServerBrowser_Status());
+
+    if (CL_ServerBrowser_IsRefreshing())
+        return;
+
+    if (CL_ServerBrowser_Count() > 0) {
+        M_Menu_ServerList_f();
+        return;
+    }
+
+    if (!qw_search_complete_time)
+        qw_search_complete_time = realtime;
+
+    M_PrintWhite(x, 72, "No servers found");
+    if ((realtime - qw_search_complete_time) > 2.0)
+        M_Menu_LanConfig_f();
+}
+
+static void
+M_Search_Key(knum_t keynum)
+{
+    switch (keynum) {
+    case K_ESCAPE:
+        CL_ServerBrowser_Cancel();
+        M_Menu_LanConfig_f();
+        break;
+    case K_SPACE:
+    case K_ENTER:
+        M_Menu_Search_f();
+        break;
+    default:
+        break;
+    }
+}
+
+static void
+M_Menu_ServerList_f(void)
+{
+    key_dest = key_menu;
+    m_state = m_slist;
+    m_entersound = true;
+    if (qw_slist_cursor >= CL_ServerBrowser_Count())
+        qw_slist_cursor = 0;
+    if (qw_slist_cursor < 0)
+        qw_slist_cursor = 0;
+    if (qw_slist_first > qw_slist_cursor)
+        qw_slist_first = qw_slist_cursor;
+}
+
+static void
+M_ServerList_Draw(void)
+{
+    const qpic8_t *p;
+    const qw_server_browser_entry_t *selected;
+    int total = CL_ServerBrowser_Count();
+
+    if (total <= 0) {
+        M_Menu_Search_f();
+        return;
+    }
+
+    if (qw_slist_cursor >= total)
+        qw_slist_cursor = total - 1;
+    if (qw_slist_cursor < 0)
+        qw_slist_cursor = 0;
+    if (qw_slist_cursor < qw_slist_first)
+        qw_slist_first = qw_slist_cursor;
+    if (qw_slist_cursor >= qw_slist_first + QW_SERVERLIST_ROWS)
+        qw_slist_first = qw_slist_cursor - QW_SERVERLIST_ROWS + 1;
+
+    p = Draw_CachePic("gfx/p_multi.lmp");
+    M_DrawTransPic((320 - p->width) / 2, 4, p);
+    M_PrintWhite(16, 32, "Ping Players Map      Server");
+
+    for (int row = 0; row < QW_SERVERLIST_ROWS; row++) {
+        char string[80];
+        int index = qw_slist_first + row;
+        const qw_server_browser_entry_t *entry;
+
+        if (index >= total)
+            break;
+
+        entry = CL_ServerBrowser_Get(index);
+        if (!entry)
+            continue;
+
+        qsnprintf(string, sizeof(string), "%4d %2d/%-2d %-8.8s %-18.18s",
+                  entry->ping, entry->users, entry->maxusers,
+                  entry->map, entry->name);
+        M_Print(16, 40 + row * 8, string);
+    }
+
+    M_DrawCursor(0, 40 + (qw_slist_cursor - qw_slist_first) * 8, 12);
+
+    selected = CL_ServerBrowser_Get(qw_slist_cursor);
+    if (selected) {
+        M_PrintWhite(16, 148, selected->address);
+    }
+    M_PrintWhite(16, 164, CL_ServerBrowser_Status());
+}
+
+static void
+M_ServerList_Key(knum_t keynum)
+{
+    int total = CL_ServerBrowser_Count();
+
+    switch (keynum) {
+    case K_ESCAPE:
+        M_Menu_LanConfig_f();
+        break;
+
+    case K_SPACE:
+        M_Menu_Search_f();
+        break;
+
+    case K_UPARROW:
+    case K_LEFTARROW:
+        if (!total)
+            break;
+        S_LocalSound("misc/menu1.wav");
+        qw_slist_cursor--;
+        if (qw_slist_cursor < 0)
+            qw_slist_cursor = total - 1;
+        break;
+
+    case K_DOWNARROW:
+    case K_RIGHTARROW:
+        if (!total)
+            break;
+        S_LocalSound("misc/menu1.wav");
+        qw_slist_cursor++;
+        if (qw_slist_cursor >= total)
+            qw_slist_cursor = 0;
+        break;
+
+    case K_PGUP:
+        if (!total)
+            break;
+        S_LocalSound("misc/menu1.wav");
+        qw_slist_cursor -= QW_SERVERLIST_ROWS;
+        if (qw_slist_cursor < 0)
+            qw_slist_cursor = 0;
+        break;
+
+    case K_PGDN:
+        if (!total)
+            break;
+        S_LocalSound("misc/menu1.wav");
+        qw_slist_cursor += QW_SERVERLIST_ROWS;
+        if (qw_slist_cursor >= total)
+            qw_slist_cursor = total - 1;
+        break;
+
+    case K_ENTER: {
+        const qw_server_browser_entry_t *entry = CL_ServerBrowser_Get(qw_slist_cursor);
+        if (!entry)
+            break;
+        S_LocalSound("misc/menu2.wav");
+        key_dest = key_game;
+        m_state = m_none;
+        Cbuf_AddText("connect \"%s\"\n", entry->address);
+        break;
+    }
+
+    default:
+        break;
+    }
+}
